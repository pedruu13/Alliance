{
  "name": "alliance-app",
  "version": "1.0.0",
  "description": "Sistema de Gestão Desktop para Joalherias com Controle de Estoque, Caixa e PDV Fiscal (Electron + Vite + SQLite)",
  "main": "electron/main.js",
  "author": "Pedro <pedruu13@github>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedruu13/Alliance.git"
  },
  "bugs": {
    "url": "https://github.com/pedruu13/Alliance/issues"
  },
  "homepage": "https://github.com/pedruu13/Alliance#readme",
  "keywords": [
    "electron",
    "vite",
    "sqlite",
    "javascript",
    "desktop-app",
    "erp",
    "inventory",
    "management-system",
    "jewelry",
    "retail"
  ],
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dev": "concurrently \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "build": "vite build"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.alliancea.app",
    "productName": "Alliancea",
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "bcryptjs": "^3.0.3",
    "jsdom": "^30.0.1",
    "lucide": "^1.28.0",
    "sql.js": "^1.14.1"
  }
}
