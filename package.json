{
  "name": "alliancea-app",
  "version": "1.0.0",
  "description": "Alliancea Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dev": "concurrently \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "build": "vite build"
  },
  "author": "Alliancea",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.alliancea.app",
    "productName": "Alliancea",
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "bcryptjs": "^3.0.3",
    "jsdom": "^30.0.1",
    "lucide": "^1.28.0",
    "sql.js": "^1.14.1"
  }
}
